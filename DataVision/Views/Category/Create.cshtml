@model Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="header d-flex align-items-center bg-light border-bottom p-4">
                    <div class="icon-circle bg-primary text-white mr-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border-radius: 50%;">
                        <i class="zmdi zmdi-plus" style="font-size: 1.8rem;"></i>
                    </div>
                    <div>
                        <h5 class="m-0 text-dark font-weight-bold">Yeni Kategori Tanımla</h5>
                        <small class="text-muted">Sisteme yeni bir veri analiz kategorisi ekliyorsunuz.</small>
                    </div>
                </div>

                <div class="body p-4">
                    <form asp-action="Create" method="post">

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="CategoryName" class="font-weight-bold text-dark">
                                        Kategori Adı
                                    </label>
                                    <div class="form-line">
                                        <input asp-for="CategoryName" class="form-control" placeholder="Örn: Müşteri Hareketleri" required autocomplete="off" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-primary btn-round shadow-sm mr-2">
                                    <i class="zmdi zmdi-floppy mr-1"></i> Kaydet
                                </button>
                                <a href="/Category/Index" class="btn btn-outline-secondary btn-round">
                                    <i class="zmdi zmdi-close mr-1"></i> İptal ve Geri Dön
                                </a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
