@model List<CustomerLoyaltyViewModel>

@{
    ViewData["Title"] = "Müşteri Sadakat (Loyalty) Analizi - ML.NET";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
    @await Component.InvokeAsync("LoyaltyHeader")

    @await Component.InvokeAsync("LoyaltyKpi")

    @await Component.InvokeAsync("LoyaltyCharts")

    <div class="card border-0 shadow-sm rounded-lg">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h6 class="font-weight-bold m-0 text-dark">Müşteri Bazlı RFM Metrikleri ve ML Tahmin Sonuçları</h6>
            <span class="text-muted small">Sayfa @currentPage / @totalPages (Toplam @totalCustomers kayıt)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th class="pl-4">Müşteri</th>
                            <th>Şehir</th>
                            <th class="text-center">Son Sipariş (Recency)</th>
                            <th class="text-center">Sipariş Sayısı (Freq.)</th>
                            <th class="text-right">Toplam Harcama (Monetary)</th>
                            <th class="text-center">Ort. Puan</th>
                            <th class="text-center">Mevcut Skor</th>
                            <th style="width: 180px;">ML Tahmin Skoru</th>
                            <th class="text-center pr-4">Segment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string progressColor = item.PredictedLoyaltyScore >= 80 ? "bg-success" :
                            item.PredictedLoyaltyScore >= 60 ? "bg-primary" :
                            item.PredictedLoyaltyScore >= 40 ? "bg-info" :
                            item.PredictedLoyaltyScore >= 25 ? "bg-warning" : "bg-danger";
                            <tr>
                                <td class="pl-4">
                                    <div class="font-weight-bold text-dark">@item.CustomerFullName</div>
                                    <small class="text-muted">ID: #@item.CustomerId</small>
                                </td>
                                <td>@item.CustomerCity</td>
                                <td class="text-center text-muted">@item.Recency gün önce</td>
                                <td class="text-center"><span class="font-weight-bold">@item.Frequency</span> kez</td>
                                <td class="text-right font-weight-bold">@item.Monetary.ToString("N2") ₺</td>
                                <td class="text-center text-warning font-weight-bold">★ @item.AverageRating.ToString("0.0")</td>
                                <td class="text-center text-muted">@item.CurrentLoyaltyScore.ToString("0.0")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="font-weight-bold mr-2" style="min-width: 38px;">@item.PredictedLoyaltyScore.ToString("0.0")</span>
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar @progressColor" style="width: @(item.PredictedLoyaltyScore.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center pr-4">
                                    <span class="@item.SegmentBadgeColor px-3 py-2 rounded-pill">@item.LoyaltySegment</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">
                <ul class="pagination justify-content-end mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Önceki</a>
                    </li>
                    @if (startPage > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1">1</a></li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@totalPages">@totalPages</a></li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Sonraki</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>