@model Message

@{
    ViewData["Title"] = "Yeni Mesaj Ekle";
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="header d-flex align-items-center bg-light border-bottom p-4">
                    <div class="icon-circle bg-primary text-white mr-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border-radius: 50%;">
                        <i class="zmdi zmdi-plus" style="font-size: 1.8rem;"></i>
                    </div>
                    <div>
                        <h5 class="m-0 text-dark font-weight-bold">Yeni Mesaj Oluştur</h5>
                        <small class="text-muted">Sisteme yeni bir müşteri mesajı ekliyorsunuz. Kaydedildiğinde Toxic-BERT ile otomatik analiz edilecektir.</small>
                    </div>
                </div>

                <div class="body p-4">
                    <form asp-action="Create" method="post">

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="CustomerId" class="font-weight-bold text-dark">Müşteri</label>
                                    <div class="form-line border-0">
                                        <select asp-for="CustomerId" class="form-control show-tick" asp-items="ViewBag.Customers" required style="cursor: pointer;">
                                            <option value="">-- Lütfen Müşteri Seçin --</option>
                                        </select>
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <label asp-for="MessageSubject" class="font-weight-bold text-dark">Mesaj Konusu</label>
                                    <div class="form-line">
                                        <input asp-for="MessageSubject" class="form-control" maxlength="100" placeholder="Örn: Kargo gecikmesi hakkında" required autocomplete="off" />
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <label asp-for="CreatedDate" class="font-weight-bold text-dark">Gönderim Tarihi (Opsiyonel)</label>
                                    <div class="form-line">
                                        <input asp-for="CreatedDate" type="datetime-local" class="form-control" />
                                    </div>
                                    <small class="text-muted">Boş bırakırsanız otomatik olarak şu anki tarih ve saat atanır.</small>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="MessageText" class="font-weight-bold text-dark">Mesaj İçeriği</label>
                                    <div class="form-line">
                                        <textarea asp-for="MessageText" class="form-control" rows="6" placeholder="Müşterinin mesaj metnini buraya girin..." required></textarea>
                                    </div>
                                </div>
                                <br />
                                <div class="alert alert-info border-0 shadow-sm mt-2 mb-0 d-flex align-items-center">
                                    <i class="zmdi zmdi-hc-2x zmdi-shield-check mr-3"></i>
                                    <div>
                                        <strong>Otomatik AI Analizi:</strong> Mesaj metni kaydedildiği anda Hugging Face <em>Toxic-BERT</em> modeli tarafından taranarak toksisite/duygu etiketi otomatik belirlenecektir.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4 border-top pt-4">
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-primary btn-round shadow-sm mr-2">
                                    <i class="zmdi zmdi-floppy mr-1"></i> Kaydet ve Analiz Et
                                </button>
                                <a href="/Message/Index" class="btn btn-outline-secondary btn-round">
                                    <i class="zmdi zmdi-close mr-1"></i> İptal
                                </a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>