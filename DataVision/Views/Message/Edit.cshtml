@model Message

@{
    ViewData["Title"] = "Mesaj Güncelle";
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="header d-flex align-items-center bg-light border-bottom p-4">
                    <div class="icon-circle bg-warning text-white mr-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border-radius: 50%;">
                        <i class="zmdi zmdi-edit" style="font-size: 1.8rem;"></i>
                    </div>
                    <div>
                        <h5 class="m-0 text-dark font-weight-bold">Mesaj Güncelle</h5>
                        <small class="text-muted">Mevcut müşteri mesajını düzenliyorsunuz. Değişiklik sonrası AI analizi yenilenecektir.</small>
                    </div>
                </div>

                <div class="body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="MessageId" />

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="CustomerId" class="font-weight-bold text-dark">Müşteri</label>
                                    <div class="form-line border-0">
                                        <select asp-for="CustomerId" class="form-control show-tick" asp-items="ViewBag.Customers" required style="cursor: pointer;">
                                            <option value="">-- Lütfen Müşteri Seçin --</option>
                                        </select>
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <label asp-for="MessageSubject" class="font-weight-bold text-dark">Mesaj Konusu</label>
                                    <div class="form-line">
                                        <input asp-for="MessageSubject" class="form-control" maxlength="100" required autocomplete="off" />
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label asp-for="CreatedDate" class="font-weight-bold text-dark">Gönderim Tarihi</label>
                                            <div class="form-line">
                                                <input asp-for="CreatedDate" type="datetime-local" class="form-control" required />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label asp-for="SentimentLabel" class="font-weight-bold text-dark">Mevcut AI Etiketi</label>
                                            <div class="form-line">
                                                <input asp-for="SentimentLabel" class="form-control text-muted" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="MessageText" class="font-weight-bold text-dark">Mesaj İçeriği</label>
                                    <div class="form-line">
                                        <textarea asp-for="MessageText" class="form-control" rows="7" required></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4 border-top pt-4">
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-warning btn-round shadow-sm mr-2 text-white">
                                    <i class="zmdi zmdi-refresh-sync mr-1"></i> Değişiklikleri Kaydet
                                </button>
                                <a href="/Message/Index" class="btn btn-outline-secondary btn-round">
                                    <i class="zmdi zmdi-close mr-1"></i> İptal
                                </a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>