@model IEnumerable<Message>

@{
	ViewData["Title"] = "Mesaj Listesi";
}

<style>
	.custom-modal-overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.55);
		z-index: 99999;
		align-items: center;
		justify-content: center;
		padding: 15px;
	}

		.custom-modal-overlay.active {
			display: flex;
		}

	.custom-modal-box {
		background: #fff;
		width: 100%;
		max-width: 700px;
		border-radius: 8px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
		overflow: hidden;
		animation: modalFadeIn 0.2s ease-out;
	}

	@@keyframes modalFadeIn {
		from {
			opacity: 0;
			transform: translateY(-15px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<div class="block-header"></div>

<div class="container-fluid mt-2">
	<div class="row clearfix">
		<div class="col-lg-12">
			<div class="card shadow-sm border-0 rounded-lg">
				<div class="header d-flex justify-content-between align-items-center bg-light border-bottom p-4">
					<div>
						<h5 class="m-0 text-dark font-weight-bold">Müşteri Mesajları</h5>
						<small class="text-muted">Sistemde kayıtlı olan tüm müşteri mesajları ve AI toksisite analizleri.</small>
					</div>
					<div class="d-flex align-items-center">
						<span class="badge badge-info px-3 py-2 font-12 mr-3">Bu Sayfada: @(Model?.Count() ?? 0) Mesaj</span>
						<a href="/Message/Create" class="btn btn-primary btn-sm btn-round shadow-sm m-0">
							<i class="zmdi zmdi-plus mr-1"></i> Yeni Mesaj Ekle
						</a>
					</div>
				</div>
				<div class="body p-0">
					<div class="table-responsive">
						<table class="table table-hover table-custom mb-0 align-middle">
							<thead class="bg-dark text-white">
								<tr>
									<th class="border-0 py-3 text-center" style="width: 80px;">#</th>
									<th class="border-0 py-3">MÜŞTERİ</th>
									<th class="border-0 py-3">MESAJ KONUSU</th>
									<th class="border-0 py-3 text-center">AI ANALİZİ (DURUM)</th>
									<th class="border-0 py-3 text-center">TARİH</th>
									<th class="border-0 py-3 text-right" style="padding-right: 2rem;">İŞLEMLER</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.Any())
								{
									foreach (var message in Model)
									{
										var customerFullName = message.Customer != null
										? $"{message.Customer.CustomerName} {message.Customer.CustomerSurname}"
										: $"Müşteri #{message.CustomerId}";

										<tr>
											<td class="text-muted font-weight-bold text-center">@message.MessageId</td>
											<td class="font-weight-bold text-dark">
												@if (message.Customer != null)
												{
													<span>@customerFullName</span>
													<div class="text-muted font-12" style="font-weight: normal;">@message.Customer.CustomerEmail</div>
												}
												else
												{
													<span class="text-muted">@customerFullName</span>
												}
											</td>
											<td class="font-weight-bold text-dark">
												@message.MessageSubject
											</td>
											<td class="text-center">
												@if (message.SentimentLabel == "Temiz / Normal" || message.SentimentLabel == "Normal")
												{
													<span class="badge badge-success px-2 py-1">
														<i class="zmdi zmdi-check-circle mr-1"></i> @message.SentimentLabel
													</span>
												}
												else if (message.SentimentLabel == "Belirsiz" || message.SentimentLabel == "Analiz Edilemedi" || message.SentimentLabel == "Analiz Hatası")
												{
													<span class="badge badge-warning text-white px-2 py-1">
														<i class="zmdi zmdi-alert-circle-o mr-1"></i> @message.SentimentLabel
													</span>
												}
												else
												{
													<span class="badge badge-danger px-2 py-1">
														<i class="zmdi zmdi-shield-security mr-1"></i> @message.SentimentLabel
													</span>
												}
											</td>
											<td class="text-center text-muted">
												@message.CreatedDate.ToString("dd.MM.yyyy HH:mm")
											</td>
											<td class="text-right" style="padding-right: 2rem;">
												<button type="button"
														class="btn btn-sm btn-outline-info btn-icon btn-icon-mini btn-round mr-2"
														data-subject="@message.MessageSubject"
														data-text="@message.MessageText"
														data-customer="@customerFullName"
														data-sentiment="@message.SentimentLabel"
														data-date="@message.CreatedDate.ToString("dd.MM.yyyy HH:mm")"
														onclick="openMessagePopup(this)"
														title="Mesajı Oku (Detay)">
													<i class="zmdi zmdi-eye"></i>
												</button>
												<a href="/Message/Edit/@message.MessageId" class="btn btn-sm btn-outline-warning btn-icon btn-icon-mini btn-round mr-2" title="Düzenle">
													<i class="zmdi zmdi-edit"></i>
												</a>
												<a href="/Message/Delete/@message.MessageId" class="btn btn-sm btn-outline-danger btn-icon btn-icon-mini btn-round" title="Sil">
													<i class="zmdi zmdi-delete"></i>
												</a>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="6" class="text-center py-5 text-muted">
											<i class="zmdi zmdi-email-open" style="font-size: 2.5rem;"></i>
											<p class="mt-3 mb-0 font-16">Veritabanında henüz hiç mesaj bulunmuyor.</p>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					@if (ViewBag.TotalPages > 1)
					{
						int current = ViewBag.CurrentPage;
						int total = ViewBag.TotalPages;

						<div class="card-footer bg-light border-top p-3 d-flex justify-content-center">
							<nav aria-label="Page navigation">
								<ul class="pagination mb-0">
									<li class="page-product @(current == 1 ? "disabled" : "")">
										<a class="page-link" href="/Message/Index?page=@(current - 1)">Önceki</a>
									</li>
									<li class="page-product @(current == 1 ? "active" : "")">
										<a class="page-link" href="/Message/Index?page=1">1</a>
									</li>
									@if (current > 3)
									{
										<li class="page-product disabled"><span class="page-link">...</span></li>
									}
									@{
										int start = Math.Max(2, current - 1);
										int end = Math.Min(total - 1, current + 1);

										if (current == 1) { end = Math.Min(total - 1, 3); }
										if (current == 2) { end = Math.Min(total - 1, 4); }
										if (current == total) { start = Math.Max(2, total - 2); }
										if (current == total - 1) { start = Math.Max(2, total - 3); }

										for (int i = start; i <= end; i++)
										{
											<li class="page-product @(current == i ? "active" : "")">
												<a class="page-link" href="/Message/Index?page=@i">@i</a>
											</li>
										}
									}
									@if (current < total - 2)
									{
										<li class="page-product disabled"><span class="page-link">...</span></li>
									}
									@if (total > 1)
									{
										<li class="page-product @(current == total ? "active" : "")">
											<a class="page-link" href="/Message/Index?page=@total">@total</a>
										</li>
									}
									<li class="page-product @(current == total ? "disabled" : "")">
										<a class="page-link" href="/Message/Index?page=@(current + 1)">Sonraki</a>
									</li>
								</ul>
							</nav>
						</div>
					}

				</div>
			</div>
		</div>
	</div>
</div>

<div id="messageDetailPopup" class="custom-modal-overlay" onclick="if(event.target === this) closeMessagePopup();">
	<div class="custom-modal-box">
		<div class="d-flex justify-content-between align-items-center bg-light border-bottom p-4">
			<div class="d-flex align-items-center">
				<div class="icon-circle bg-info text-white mr-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 50%;">
					<i class="zmdi zmdi-email-open" style="font-size: 1.4rem;"></i>
				</div>
				<div>
					<h5 class="m-0 text-dark font-weight-bold" id="popupSubject">Mesaj Konusu</h5>
					<small class="text-muted" id="popupCustomer">Gönderen Müşteri</small>
				</div>
			</div>
			<button type="button" class="close" onclick="closeMessagePopup()" style="font-size: 1.8rem; line-height: 1; border: none; background: transparent; cursor: pointer;">
				<span>&times;</span>
			</button>
		</div>

		<div class="p-4">
			<div class="row mb-3">
				<div class="col-6">
					<span class="text-muted font-12">Gönderim Tarihi:</span>
					<div class="font-weight-bold text-dark mt-1" id="popupDate">--</div>
				</div>
				<div class="col-6 text-right">
					<span class="text-muted font-12">AI Analiz Durumu:</span>
					<div class="mt-1" id="popupSentiment">--</div>
				</div>
			</div>
			<hr />
			<div class="form-group mt-3 mb-0">
				<label class="font-weight-bold text-dark mb-2">Mesaj İçeriği:</label>
				<div class="p-3 bg-light rounded text-dark border" id="popupText" style="white-space: pre-wrap; line-height: 1.6; max-height: 320px; overflow-y: auto; font-size: 0.95rem;">
				</div>
			</div>
		</div>

		<div class="bg-light border-top p-3 text-right">
			<button type="button" class="btn btn-secondary btn-round px-4 m-0" onclick="closeMessagePopup()">
				<i class="zmdi zmdi-close mr-1"></i> Kapat
			</button>
		</div>
	</div>
</div>

<script>
	function openMessagePopup(button) {
		var subject = button.getAttribute('data-subject') || '';
		var text = button.getAttribute('data-text') || '';
		var customer = button.getAttribute('data-customer') || '';
		var sentiment = button.getAttribute('data-sentiment') || '';
		var date = button.getAttribute('data-date') || '';

		document.getElementById('popupSubject').textContent = subject;
		document.getElementById('popupCustomer').textContent = 'Müşteri: ' + customer;
		document.getElementById('popupText').textContent = text;
		document.getElementById('popupDate').textContent = date;

		var badgeHtml = '';
		if (sentiment === 'Temiz / Normal' || sentiment === 'Normal') {
			badgeHtml = '<span class="badge badge-success px-2 py-1"><i class="zmdi zmdi-check-circle mr-1"></i> ' + sentiment + '</span>';
		} else if (sentiment === 'Belirsiz' || sentiment === 'Analiz Edilemedi' || sentiment === 'Analiz Hatası') {
			badgeHtml = '<span class="badge badge-warning text-white px-2 py-1"><i class="zmdi zmdi-alert-circle-o mr-1"></i> ' + sentiment + '</span>';
		} else {
			badgeHtml = '<span class="badge badge-danger px-2 py-1"><i class="zmdi zmdi-shield-security mr-1"></i> ' + sentiment + '</span>';
		}

		document.getElementById('popupSentiment').innerHTML = badgeHtml;
		document.getElementById('messageDetailPopup').classList.add('active');
	}

	function closeMessagePopup() {
		document.getElementById('messageDetailPopup').classList.remove('active');
	}

	// ESC tuşuna basınca pop-up'ı kapat
	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape') {
			closeMessagePopup();
		}
	});
</script>