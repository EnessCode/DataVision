@model Order

@{
    ViewData["Title"] = "Sipariş Güncelle";
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="header d-flex align-items-center bg-light border-bottom p-4">
                    <div class="icon-circle bg-warning text-white mr-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border-radius: 50%;">
                        <i class="zmdi zmdi-edit" style="font-size: 1.8rem;"></i>
                    </div>
                    <div>
                        <h5 class="m-0 text-dark font-weight-bold">Sipariş Güncelle</h5>
                        <small class="text-muted">Mevcut bir siparişin durumunu veya detaylarını düzenliyorsunuz.</small>
                    </div>
                </div>

                <div class="body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="OrderId" />

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="CustomerId" class="font-weight-bold text-dark">Müşteri ID</label>
                                    <div class="form-line">
                                        <input asp-for="CustomerId" type="number" class="form-control" required autocomplete="off" />
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <label asp-for="ProductId" class="font-weight-bold text-dark">Ürün ID</label>
                                    <div class="form-line">
                                        <input asp-for="ProductId" type="number" class="form-control" required autocomplete="off" />
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label asp-for="Quantity" class="font-weight-bold text-dark">Adet (Miktar)</label>
                                            <div class="form-line">
                                                <input asp-for="Quantity" type="number" class="form-control" required min="1" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label asp-for="OrderDate" class="font-weight-bold text-dark">Sipariş Tarihi</label>
                                            <div class="form-line">
                                                <input asp-for="OrderDate" type="datetime-local" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-6">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label asp-for="PaymentMethod" class="font-weight-bold text-dark">Ödeme Yöntemi</label>
                                            <div class="form-line border-0">
                                                <select asp-for="PaymentMethod" class="form-control show-tick" style="cursor: pointer;">
                                                    <option value="Kredi Kartı">Kredi Kartı</option>
                                                    <option value="Banka Kartı">Banka Kartı</option>
                                                    <option value="PayPal">PayPal</option>
                                                    <option value="Google Pay">Google Pay</option>
                                                    <option value="Apple Pay">Apple Pay</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label asp-for="OrderStatus" class="font-weight-bold text-dark">Sipariş Durumu</label>
                                            <div class="form-line border-0">
                                                <select asp-for="OrderStatus" class="form-control show-tick" style="cursor: pointer;">
                                                    <option value="Beklemede">Beklemede</option>
                                                    <option value="Hazırlanıyor">Hazırlanıyor</option>
                                                    <option value="Kargoda">Kargoda</option>
                                                    <option value="Tamamlandı">Tamamlandı</option>
                                                    <option value="İptal Edildi">İptal Edildi</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="form-group">
                                    <label asp-for="OrderNotes" class="font-weight-bold text-dark">Sipariş Notları</label>
                                    <div class="form-line">
                                        <textarea asp-for="OrderNotes" class="form-control" rows="4"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4 border-top pt-4">
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-warning btn-round shadow-sm mr-2 text-white">
                                    <i class="zmdi zmdi-refresh-sync mr-1"></i> Değişiklikleri Kaydet
                                </button>
                                <a href="/Order/Index" class="btn btn-outline-secondary btn-round">
                                    <i class="zmdi zmdi-close mr-1"></i> İptal
                                </a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>