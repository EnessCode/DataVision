@model IEnumerable<Product>

@{
	ViewData["Title"] = "Ürün Listesi";
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
	<div class="row clearfix">
		<div class="col-lg-12">
			<div class="card shadow-sm border-0 rounded-lg">
				<div class="header d-flex justify-content-between align-products-center bg-light border-bottom p-4">
					<div>
						<h5 class="m-0 text-dark font-weight-bold">Ürün Listesi</h5>
						<small class="text-muted">Sistemde kayıtlı olan tüm ürünler ve detayları.</small>
					</div>
					<div class="d-flex align-products-center">
						<span class="badge badge-info px-3 py-2 font-12 mr-3">Toplam: @(Model?.Count() ?? 0) Ürün</span>
						<a href="/Product/Create" class="btn btn-primary btn-sm btn-round shadow-sm m-0">
							<i class="zmdi zmdi-plus mr-1"></i> Yeni Ürün Ekle
						</a>
					</div>
				</div>
				<div class="body p-0">
					<div class="table-responsive">
						<table class="table table-hover table-custom mb-0 align-middle">
							<thead class="bg-dark text-white">
								<tr>
									<th class="border-0 py-3 text-center" style="width: 80px;">#</th>
									<th class="border-0 py-3">ÜRÜN ADI</th>
									<th class="border-0 py-3">KATEGORİ ADI</th>
									<th class="border-0 py-3 text-right">FİYAT</th>
									<th class="border-0 py-3 text-center">STOK</th>
									<th class="border-0 py-3 text-center">MENŞEİ</th>
									<th class="border-0 py-3 text-right" style="padding-right: 2rem;">İŞLEMLER</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.Any())
								{
									foreach (var product in Model)
									{
										<tr>
											<td class="text-muted font-weight-bold text-center">@product.ProductId</td>
											<td class="font-weight-bold text-dark">
												@product.ProductName
												<div class="text-muted font-12" style="font-weight: normal;">@product.ProductDescription</div>
											</td>
											<td><span class="badge badge-default">@product.Category.CategoryName</span></td>
											<td class="text-right font-weight-bold text-success">@product.UnitPrice.ToString("C")</td>
											<td class="text-center">
												@if (product.StockQuantity > 10)
												{
													<span class="badge badge-success">@product.StockQuantity</span>
												}
												else
												{
													<span class="badge badge-danger">@product.StockQuantity (Kritik)</span>
												}
											</td>
											<td class="text-center">@product.CountryOfOrigin</td>
											<td class="text-right" style="padding-right: 2rem;">
												<a href="/Product/Edit/@product.ProductId" class="btn btn-sm btn-outline-warning btn-icon btn-icon-mini btn-round mr-2" title="Düzenle">
													<i class="zmdi zmdi-edit"></i>
												</a>
												<a href="/Product/Delete/@product.ProductId" class="btn btn-sm btn-outline-danger btn-icon btn-icon-mini btn-round" title="Sil">
													<i class="zmdi zmdi-delete"></i>
												</a>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="7" class="text-center py-5 text-muted">
											<i class="zmdi zmdi-info-outline" style="font-size: 2.5rem;"></i>
											<p class="mt-3 mb-0 font-16">Veritabanında henüz hiç ürün bulunmuyor.</p>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					@if (ViewBag.TotalPages > 1)
					{
						int current = ViewBag.CurrentPage;
						int total = ViewBag.TotalPages;

						<div class="card-footer bg-light border-top p-3 d-flex justify-content-center">
							<nav aria-label="Page navigation">
								<ul class="pagination mb-0">

									<li class="page-product @(current == 1 ? "disabled" : "")">
										<a class="page-link" href="/Product/Index?page=@(current - 1)">Önceki</a>
									</li>

									<li class="page-product @(current == 1 ? "active" : "")">
										<a class="page-link" href="/Product/Index?page=1">1</a>
									</li>

									@if (current > 3)
									{
										<li class="page-product disabled"><span class="page-link">...</span></li>
									}

									@{
										int start = Math.Max(2, current - 1);
										int end = Math.Min(total - 1, current + 1);

										if (current == 1) { end = Math.Min(total - 1, 3); }
										if (current == 2) { end = Math.Min(total - 1, 4); }
										if (current == total) { start = Math.Max(2, total - 2); }
										if (current == total - 1) { start = Math.Max(2, total - 3); }

										for (int i = start; i <= end; i++)
										{
											<li class="page-product @(current == i ? "active" : "")">
												<a class="page-link" href="/Product/Index?page=@i">@i</a>
											</li>
										}
									}

									@if (current < total - 2)
									{
										<li class="page-product disabled"><span class="page-link">...</span></li>
									}

									@if (total > 1)
									{
										<li class="page-product @(current == total ? "active" : "")">
											<a class="page-link" href="/Product/Index?page=@total">@total</a>
										</li>
									}

									<li class="page-product @(current == total ? "disabled" : "")">
										<a class="page-link" href="/Product/Index?page=@(current + 1)">Sonraki</a>
									</li>

								</ul>
							</nav>
						</div>
					}

				</div>
			</div>
		</div>
	</div>
</div>