@model IEnumerable<Review>

@{
	ViewData["Title"] = "Değerlendirme Listesi";
}

<div class="block-header"></div>

<div class="container-fluid mt-2">
	<div class="row clearfix">
		<div class="col-lg-12">
			<div class="card shadow-sm border-0 rounded-lg">
				<div class="header d-flex justify-content-between align-items-center bg-light border-bottom p-4">
					<div>
						<h5 class="m-0 text-dark font-weight-bold">Değerlendirme Listesi</h5>
						<small class="text-muted">Sistemde kayıtlı olan tüm ürün yorumları, puanlar ve duygu analizleri.</small>
					</div>
					<div class="d-flex align-items-center">
						<span class="badge badge-info px-3 py-2 font-12 mr-3">Toplam: @(Model?.Count() ?? 0) Yorum</span>
						<a href="/Review/Create" class="btn btn-primary btn-sm btn-round shadow-sm m-0">
							<i class="zmdi zmdi-plus mr-1"></i> Yeni Yorum Ekle
						</a>
					</div>
				</div>
				<div class="body p-0">
					<div class="table-responsive">
						<table class="table table-hover table-custom mb-0 align-middle">
							<thead class="bg-dark text-white">
								<tr>
									<th class="border-0 py-3 text-center" style="width: 60px;"># ID</th>
									<th class="border-0 py-3" style="width: 180px;">MÜŞTERİ & ÜRÜN</th>
									<th class="border-0 py-3">YORUM DETAYI</th>
									<th class="border-0 py-3 text-center" style="width: 100px;">PUAN</th>
									<th class="border-0 py-3 text-center" style="width: 120px;">DUYGU</th>
									<th class="border-0 py-3 text-center" style="width: 120px;">TARIH</th>
									<th class="border-0 py-3 text-right" style="padding-right: 2rem; width: 100px;">İŞLEMLER</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.Any())
								{
									foreach (var review in Model)
									{
										<tr>
											<td class="text-muted font-weight-bold text-center">@review.ReviewId</td>
											<td>
												<div class="font-weight-bold text-dark">
													<i class="zmdi zmdi-account mr-1 text-muted"></i> @(review.Customer != null ? review.Customer.CustomerName + " " + review.Customer.CustomerSurname : "Bilinmeyen Müşteri")
												</div>
												<div class="text-muted font-12">
													<i class="zmdi zmdi-shopping-cart mr-1"></i> @(review.Product != null ? review.Product.ProductName : "Bilinmeyen Ürün")
												</div>
											</td>
											<td>
												<div class="text-dark text-truncate" style="max-width: 350px;" title="@review.ReviewText">
													@review.ReviewText
												</div>
												<span class="badge badge-secondary font-11 mt-1">@review.PurchaseType</span>
											</td>
											<td class="text-center">
												<span class="badge badge-warning px-2 py-1 font-weight-bold">
													<i class="zmdi zmdi-star mr-1"></i> @review.Rating / 5
												</span>
											</td>
											<td class="text-center">
												@if (review.Sentiment == "Positive" || review.Sentiment == "Olumlu")
												{
													<span class="badge badge-success">Olumlu</span>
												}
												else if (review.Sentiment == "Negative" || review.Sentiment == "Olumsuz")
												{
													<span class="badge badge-danger">Olumsuz</span>
												}
												else
												{
													<span class="badge badge-secondary">Nötr</span>
												}
											</td>
											<td class="text-center text-muted font-12">
												@review.ReviewDate.ToString("dd.MM.yyyy")
											</td>
											<td class="text-right" style="padding-right: 2rem;">
												<a href="/Review/Edit/@review.ReviewId" class="btn btn-sm btn-outline-warning btn-icon btn-icon-mini btn-round mr-2" title="Düzenle">
													<i class="zmdi zmdi-edit"></i>
												</a>
												<a href="/Review/Delete/@review.ReviewId" class="btn btn-sm btn-outline-danger btn-icon btn-icon-mini btn-round" title="Sil">
													<i class="zmdi zmdi-delete"></i>
												</a>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="7" class="text-center py-5 text-muted">
											<i class="zmdi zmdi-comment-outline" style="font-size: 2.5rem;"></i>
											<p class="mt-3 mb-0 font-16">Veritabanında henüz hiç değerlendirme bulunmuyor.</p>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					@if (ViewBag.TotalPages > 1)
					{
						int current = ViewBag.CurrentPage;
						int total = ViewBag.TotalPages;

						<div class="card-footer bg-light border-top p-3 d-flex justify-content-center">
							<nav aria-label="Page navigation">
								<ul class="pagination mb-0">

									<li class="page-item @(current == 1 ? "disabled" : "")">
										<a class="page-link" href="/Review/Index?page=@(current - 1)">Önceki</a>
									</li>

									<li class="page-item @(current == 1 ? "active" : "")">
										<a class="page-link" href="/Review/Index?page=1">1</a>
									</li>

									@if (current > 3)
									{
										<li class="page-item disabled"><span class="page-link">...</span></li>
									}

									@{
										int start = Math.Max(2, current - 1);
										int end = Math.Min(total - 1, current + 1);

										if (current == 1) { end = Math.Min(total - 1, 3); }
										if (current == 2) { end = Math.Min(total - 1, 4); }
										if (current == total) { start = Math.Max(2, total - 2); }
										if (current == total - 1) { start = Math.Max(2, total - 3); }

										for (int i = start; i <= end; i++)
										{
											<li class="page-item @(current == i ? "active" : "")">
												<a class="page-link" href="/Review/Index?page=@i">@i</a>
											</li>
										}
									}

									@if (current < total - 2)
									{
										<li class="page-item disabled"><span class="page-link">...</span></li>
									}

									@if (total > 1)
									{
										<li class="page-item @(current == total ? "active" : "")">
											<a class="page-link" href="/Review/Index?page=@total">@total</a>
										</li>
									}

									<li class="page-item @(current == total ? "disabled" : "")">
										<a class="page-link" href="/Review/Index?page=@(current + 1)">Sonraki</a>
									</li>

								</ul>
							</nav>
						</div>
					}

				</div>
			</div>
		</div>
	</div>
</div>