@model DashboardAnnualReportViewModel

<div class="card product-report border-0 shadow-sm rounded-lg mb-4">
    <div class="header d-flex justify-content-between align-items-center bg-light border-bottom p-4 rounded-top">
        <div>
            <h2 class="m-0 font-weight-bold text-dark">
                Yıllık Satış ve Finans Raporu
                <small class="text-muted d-block mt-1">Sipariş durumlarının dönemlere göre dağılımı ve finansal özet.</small>
            </h2>
        </div>
    </div>
    <div class="body p-4">
        <div class="row clearfix mb-4">
            <div class="col-lg-4 col-md-4 col-sm-12 mb-3 mb-md-0">
                <div class="d-flex align-items-center p-3 bg-light rounded-lg border">
                    <div class="icon l-amber mr-3 d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; min-width: 48px;">
                        <i class="zmdi zmdi-money-box font-24"></i>
                    </div>
                    <div class="col-in">
                        <h4 class="m-b-0 font-weight-bold text-dark">₺@Model.TotalRevenue.ToString("N0")</h4>
                        <small class="text-muted m-t-0">Toplam Ciro</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-12 mb-3 mb-md-0">
                <div class="d-flex align-items-center p-3 bg-light rounded-lg border">
                    <div class="icon l-turquoise mr-3 d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; min-width: 48px;">
                        <i class="zmdi zmdi-chart font-24"></i>
                    </div>
                    <div class="col-in">
                        <h4 class="m-b-0 font-weight-bold text-dark">₺@Model.MonthlyRevenue.ToString("N0")</h4>
                        <small class="text-muted m-t-0">Bu Ayki Ciro</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-12">
                <div class="d-flex align-items-center p-3 bg-light rounded-lg border">
                    <div class="icon l-parpl mr-3 d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; min-width: 48px;">
                        <i class="zmdi zmdi-shopping-cart-plus font-24"></i>
                    </div>
                    <div class="col-in">
                        <h4 class="m-b-0 font-weight-bold text-dark">₺@Model.AverageOrderValue.ToString("N2")</h4>
                        <small class="text-muted m-t-0">Ortalama Sepet Tutarı</small>
                    </div>
                </div>
            </div>
        </div>

        <div style="position: relative; height: 325px; width: 100%;">
            <canvas id="annualReportCanvas"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        var rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData));
        if (!rawData || rawData.length === 0) return;

        var labels = rawData.map(x => x.Period !== undefined ? x.Period : x.period);
        var completedData = rawData.map(x => x.Completed !== undefined ? x.Completed : x.completed);
        var pendingData = rawData.map(x => x.Pending !== undefined ? x.Pending : x.pending);
        var cancelledData = rawData.map(x => x.Cancelled !== undefined ? x.Cancelled : x.cancelled);

        var ctx = document.getElementById('annualReportCanvas').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Tamamlanan',
                        data: completedData,
                        borderColor: '#00ced1',
                        backgroundColor: 'rgba(0, 206, 209, 0.25)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4, 
                        pointRadius: 3
                    },
                    {
                        label: 'Bekleyen',
                        data: pendingData,
                        borderColor: '#ffa07a',
                        backgroundColor: 'rgba(255, 160, 122, 0.25)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3
                    },
                    {
                        label: 'İptal Edilen',
                        data: cancelledData,
                        borderColor: '#a890d3',
                        backgroundColor: 'rgba(168, 144, 211, 0.25)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            padding: 15
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#f0f0f0'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    })();
</script>