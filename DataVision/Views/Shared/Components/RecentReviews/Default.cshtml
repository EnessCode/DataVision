@model IEnumerable<Review>

<div class="card shadow-sm border-0 rounded-lg h-100">
    <div class="header bg-white border-0 pt-4 px-4 pb-2">
        <h6 class="m-0 text-dark font-weight-bold" style="font-size: 1rem;">Son 5 Değerlendirme</h6>
    </div>
    <div class="body px-4 pt-2 pb-4">
        <ul class="list-unstyled mb-0">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <li class="media d-flex align-items-start mb-4 pb-1">
                        <div class="icon-circle bg-light text-primary mr-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;">
                            <i class="zmdi zmdi-account" style="font-size: 1.3rem;"></i>
                        </div>
                        <div class="media-body">
                            <h6 class="mt-0 mb-1 text-dark font-weight-bold" style="font-size: 0.9rem;">
                                @(item.Customer != null ? item.Customer.CustomerName + " " + item.Customer.CustomerSurname : "Müşteri") - @(item.Product != null ? item.Product.ProductName : "Ürün")
                            </h6>
                            <p class="text-muted mb-1" style="font-size: 0.85rem; line-height: 1.3;">
                                @item.ReviewText
                            </p>
                            <small class="text-info font-weight-bold" style="font-size: 0.75rem;">
                                @item.ReviewDate.ToString("dd-MMM-yyyy", new System.Globalization.CultureInfo("tr-TR"))
                            </small>
                        </div>
                    </li>
                }
            }
            else
            {
                <li class="text-muted text-center py-4">Henüz değerlendirme bulunmuyor.</li>
            }
        </ul>
    </div>
</div>